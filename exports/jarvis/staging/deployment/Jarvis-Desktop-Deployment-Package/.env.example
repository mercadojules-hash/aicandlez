# ── Jarvis Desktop Edition — environment template ───────────────────────────
# Copy to `.env` and fill in. Hybrid profile: Ollama cognition + OpenAI embeddings.

# ── Database (local Postgres + pgvector) ────────────────────────────────────
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# ── Cognition: Ollama (local LLM, OpenAI-compatible endpoint) ────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
JARVIS_OLLAMA_MODEL=llama3.1
# Ollama ignores the key value, but the OpenAI SDK requires a non-empty string:
OLLAMA_API_KEY=ollama

# ── Embeddings: OpenAI (UNCHANGED — required for semantic memory/knowledge) ──
# If omitted, semantic search degrades to lexical (no crash).
OPENAI_API_KEY=sk-REPLACE_ME

# ── Vault (encrypts stored credentials at rest) ─────────────────────────────
# Generate: openssl rand -hex 32
VAULT_MASTER_KEY=REPLACE_WITH_32_BYTE_HEX

# ── Auth: Clerk (external SaaS — use your own Clerk application keys) ────────
CLERK_SECRET_KEY=sk_test_REPLACE_ME
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Frontend → backend base URL ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ── Local object storage (creative/vision/vault binaries) ───────────────────
# Filesystem adapter root (created during implementation phase).
JARVIS_STORAGE_DIR=./.local-storage

# ── Optional ────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=        # premium voice readback (browser voice needs none)
# GITHUB_PAT=                # sovereignty repo awareness (deferred in Phase 1)
# RENDER_API_KEY=            # sovereignty infra awareness (optional)

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
