# ── Jarvis Desktop Edition — environment ──────────────────────────────────────
# Copy this file to .env  (cp .env.example .env)  before running `pnpm dev`.
# Every value below is OPTIONAL — sensible localhost defaults apply when unset.

# ── PostgreSQL (pgvector-enabled) ─────────────────────────────────────────────
# Without DATABASE_URL the app still boots in a degraded in-memory mock-DB mode
# (reads return empty, writes are no-ops). Set it for full persistence.
DATABASE_URL=postgresql://localhost:5432/jarvis

# ── Local LLM (Ollama) — DEFAULT cognition provider, fully offline ────────────
# Cognition uses these whenever no cloud key (below) is present.
OLLAMA_BASE_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=llama3.1

# ── Optional cloud cognition (takes priority over Ollama when set) ────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # also enables 1536-dim semantic embeddings (else lexical fallback)
# JARVIS_OPENAI_COGNITION_MODEL=gpt-4o

# ── Frontend ──────────────────────────────────────────────────────────────────
# Clerk is fully stubbed in Desktop Edition (single local super-admin). This
# placeholder only satisfies the app's "key present" guard; its value is ignored.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_desktop_stub
# Leave empty so the Vite dev server proxies /api -> the local backend.
VITE_API_BASE_URL=

# ── Ports (defaults: backend 5050, web 5173) ─────────────────────────────────
# JARVIS_SERVER_PORT=5050
# JARVIS_WEB_PORT=5173
# VITE_API_PROXY=http://localhost:5050

# ── Network exposure (SECURITY) ──────────────────────────────────────────────
# Desktop Edition authorizes EVERY request as the single local super-admin, so
# the API binds to loopback (127.0.0.1) by default and CORS only allows the local
# web origin. Do NOT expose this to a LAN unless you understand the implications.
# JARVIS_BIND_HOST=127.0.0.1            # set to 0.0.0.0 to deliberately expose on LAN
# JARVIS_CORS_ORIGINS=                  # comma-separated extra allowed browser origins

# ── Local identity (the single desktop super-admin) ──────────────────────────
JARVIS_LOCAL_USER_ID=local-admin
JARVIS_LOCAL_EMAIL=admin@localhost

# ── Optional: GitHub repo-awareness (no Replit needed) ───────────────────────
# Set a token for the operational dossier's GitHub awareness. Without it (and off
# Replit) that single feature simply returns "not configured".
# GITHUB_TOKEN=

# ── Optional: object storage (Vault media / creative image bytes) ────────────
# These specific features need either Replit object storage or Google Cloud
# Storage creds. Absent both, only those media features are unavailable; core
# cognition, graph, governance, and voice work normally.
